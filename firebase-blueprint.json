{
  "entities": {
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global operating system configuration including demo/production mode",
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["demo", "production"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["mode"]
    },
    "CertificationApplication": {
      "title": "Certification Application",
      "description": "Customer certification request and active assessment workflow record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicationNumber": { "type": "string" },
        "companyName": { "type": "string" },
        "legalCountry": { "type": "string" },
        "representativeName": { "type": "string" },
        "officialEmail": { "type": "string" },
        "stage": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "companyName", "stage"]
    },
    "PublicCertifiedProject": {
      "title": "Public Certified Project",
      "description": "Verified certified project published in public registry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "certificateNumber": { "type": "string" },
        "certificateStatus": { "type": "string" }
      },
      "required": ["id", "name", "certificateNumber"]
    },
    "CrmLead": {
      "title": "CRM Lead",
      "description": "Sales pipeline lead",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "companyName"]
    },
    "AuditLogEntry": {
      "title": "Audit Log Entry",
      "description": "Immutable enterprise audit log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" }
      },
      "required": ["id", "timestamp", "action"]
    }
  },
  "firestore": {
    "systemConfig": {
      "schema": "SystemSettings",
      "description": "System operating mode configuration"
    },
    "certifiedProjects": {
      "schema": "PublicCertifiedProject",
      "description": "Public certificate registry"
    },
    "applications": {
      "schema": "CertificationApplication",
      "description": "Certification workflow applications"
    },
    "leads": {
      "schema": "CrmLead",
      "description": "Sales lead management collection"
    },
    "auditLogs": {
      "schema": "AuditLogEntry",
      "description": "System audit trail"
    }
  }
}
